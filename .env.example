# Endpoint do Microsoft Foundry (compatível com OpenAI). Apenas o host, SEM
# caminho (ex.: /openai/v1 ou /responses) — o SDK monta a rota automaticamente
# para o provider "azure".
FOUNDRY_BASE_URL=https://meu-recurso.services.ai.azure.com
FOUNDRY_API_KEY=troque-pela-chave-do-foundry
FOUNDRY_MODEL=gpt-4o

# Segundo modelo opcional, no mesmo endpoint e com a mesma api key acima —
# habilita o dropdown de modelos no frontend. Deixe em branco para rodar com
# um único modelo.
FOUNDRY_MODEL_2=

# Modelo de embedding do Foundry, usado pelo script de ingestão e pelo RAG
# (mesmo endpoint/api key dos modelos de chat acima).
FOUNDRY_MODEL_EMBEDDINGS=text-embedding-3-large

# Host/porta da API do agente
APP_HOST=0.0.0.0
APP_PORT=8000

# Banco vetorial (RAG). "http://localhost:6333" quando o agente roda fora do
# container (scripts/start-agent.ps1); "http://qdrant:6333" quando tudo roda
# via docker-compose.
QDRANT_URL=http://localhost:6333
